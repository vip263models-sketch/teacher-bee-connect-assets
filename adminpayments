<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Admin · Payments · TeacherBee Connect</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #F3F6F9;
            color: #0F172A;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-header {
            background: #0F172A;
            color: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .admin-header h1 {
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: -0.3px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            border: none;
            cursor: pointer;
            transition: 0.2s;
            text-decoration: none;
        }
        .btn-outline-light { background: transparent; border: 1px solid rgba(255,255,255,0.3); color: white; }
        .btn-outline-light:hover { background: rgba(255,255,255,0.1); }
        .container {
            max-width: 1300px;
            margin: 2rem auto;
            width: 100%;
            padding: 0 1.5rem;
            flex: 1;
        }
        .card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            padding: 1.5rem;
            overflow-x: auto;
        }
        .filters {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            align-items: center;
        }
        .filters select, .filters input {
            padding: 0.6rem 1rem;
            border: 1.5px solid #E2E8F0;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.9rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        th {
            text-align: left;
            padding: 0.8rem 0.5rem;
            color: #64748B;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #E2E8F0;
        }
        td {
            padding: 0.7rem 0.5rem;
            border-bottom: 1px solid #E2E8F0;
            vertical-align: middle;
        }
        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.7rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .status-pending { background: #FEF3C7; color: #92400E; }
        .status-approved { background: #D1FAE5; color: #065F46; }
        .status-rejected, .status-cancelled { background: #FEE2E2; color: #991B1B; }
        .action-btns { display: flex; gap: 0.3rem; flex-wrap: wrap; }
        .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.75rem; }
        .btn-primary { background: #F5A623; color: #1A1A1A; }
        .btn-primary:hover { background: #D4920E; }
        .btn-danger { background: #DC2626; color: white; }
        .btn-success { background: #10B981; color: white; }
        .btn-outline { background: transparent; border: 1px solid #E2E8F0; color: #0F172A; }
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5); z-index: 9999;
            display: none; justify-content: center; align-items: center; padding: 1rem;
        }
        .modal-overlay.active { display: flex; }
        .modal-content {
            background: white; border-radius: 16px; max-width: 700px; width: 100%;
            max-height: 90vh; overflow-y: auto; padding: 2rem;
            position: relative;
        }
        .close-modal {
            position: absolute; top: 1rem; right: 1rem;
            background: none; border: none; font-size: 1.5rem; cursor: pointer;
        }
        #toast-container {
            position: fixed; top: 20px; right: 20px; z-index: 9999;
            display: flex; flex-direction: column; gap: 8px;
        }
        .toast {
            padding: 0.75rem 1.3rem; border-radius: 8px; font-weight: 600;
            color: white; animation: slideDown 0.3s;
        }
        @keyframes slideDown { from{transform:translateY(-20px);opacity:0} to{transform:translateY(0);opacity:1} }
        .hidden { display: none !important; }
    </style>
</head>
<body>
    <div class="admin-header">
        <h1><span style="color:#F5A623;">🐝</span> Admin Panel · Payment Management</h1>
        <button class="btn btn-outline-light" onclick="signOut()"><i class="fa-solid fa-right-from-bracket"></i> Log Out</button>
    </div>

    <div class="container">
        <div class="card">
            <div class="filters">
                <select id="status-filter" onchange="filterPayments()">
                    <option value="all">All Statuses</option>
                    <option value="pending" selected>Pending</option>
                    <option value="approved">Approved</option>
                    <option value="rejected">Rejected</option>
                    <option value="cancelled">Cancelled</option>
                </select>
                <input type="text" id="search-input" placeholder="Search by name or email" oninput="filterPayments()">
            </div>
            <table id="payments-table">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="payments-tbody">
                    <tr><td colspan="6" style="text-align:center;padding:2rem;">Loading payments...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal-overlay" id="detail-modal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeModal()">&times;</button>
            <h2>Payment Details</h2>
            <div id="modal-body"></div>
        </div>
    </div>

    <div id="toast-container"></div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
        import { getFirestore, collection, getDocs, query, where, orderBy, doc, getDoc, updateDoc, deleteDoc, serverTimestamp, setDoc, limit, startAfter, Timestamp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyBMKjt1RUZXVxTmadiCqKhNbzSPsNUDxV8",
            authDomain: "teacherbee-connect.firebaseapp.com",
            projectId: "teacherbee-connect",
            storageBucket: "teacherbee-connect.firebasestorage.app",
            messagingSenderId: "345613317767",
            appId: "1:345613317767:web:555713e479f9837e84aa22"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        let allPayments = [];
        let currentAdmin = null;

        onAuthStateChanged(auth, async (user) => {
            if (!user) {
                window.location.href = 'login.html'; // redirect to admin login
                return;
            }
            // Check admin claim
            const token = await user.getIdTokenResult();
            if (!token.claims.admin) {
                showToast('Access denied. Admin only.', 'error');
                await signOut(auth);
                window.location.href = 'login.html';
                return;
            }
            currentAdmin = user;
            document.getElementById('admin-name').innerText = user.email;
            loadPayments();
        });

        async function loadPayments() {
            const tbody = document.getElementById('payments-tbody');
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">Loading...</td></tr>';
            try {
                const paymentsRef = collection(db, 'payments');
                const q = query(paymentsRef, orderBy('createdAt', 'desc'));
                const snapshot = await getDocs(q);
                allPayments = [];
                snapshot.forEach(doc => {
                    allPayments.push({ id: doc.id, ...doc.data() });
                });
                renderPayments(allPayments);
            } catch (e) {
                console.error(e);
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:red;">Failed to load payments. Check console.</td></tr>';
            }
        }

        function filterPayments() {
            const status = document.getElementById('status-filter').value;
            const search = document.getElementById('search-input').value.toLowerCase();
            let filtered = allPayments;
            if (status !== 'all') filtered = filtered.filter(p => p.status === status);
            if (search) {
                filtered = filtered.filter(p => {
                    const cust = p.customer || {};
                    return (cust.name || '').toLowerCase().includes(search) ||
                           (cust.email || '').toLowerCase().includes(search) ||
                           (p.id || '').toLowerCase().includes(search);
                });
            }
            renderPayments(filtered);
        }

        function renderPayments(payments) {
            const tbody = document.getElementById('payments-tbody');
            tbody.innerHTML = '';
            if (payments.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;">No payments found.</td></tr>';
                return;
            }
            payments.forEach(p => {
                const invId = p.id.substring(0,8).toUpperCase();
                const cust = p.customer || {};
                const amount = p.amount || 0;
                const status = p.status || 'pending';
                const date = p.createdAt ? p.createdAt.toDate().toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) : '—';
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td><strong>#${invId}</strong></td>
                    <td>${escapeHTML(cust.name || '—')}<br><small>${escapeHTML(cust.email || '')}</small></td>
                    <td>$${amount}</td>
                    <td><span class="status-badge status-${status}">${status}</span></td>
                    <td>${date}</td>
                    <td class="action-btns">
                        <button class="btn btn-sm btn-outline" onclick="viewDetails('${p.id}')"><i class="fa-solid fa-eye"></i></button>
                        ${status === 'pending' ? `
                            <button class="btn btn-sm btn-success" onclick="approvePayment('${p.id}')">Approve</button>
                            <button class="btn btn-sm btn-danger" onclick="rejectPayment('${p.id}')">Reject</button>
                        ` : ''}
                        <button class="btn btn-sm btn-danger" onclick="deletePayment('${p.id}')"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        window.viewDetails = async (paymentId) => {
            const payment = allPayments.find(p => p.id === paymentId);
            if (!payment) return;
            const cust = payment.customer || {};
            const periodMap = { monthly:'Monthly', quarterly:'3 Months', biannually:'6 Months', annually:'12 Months' };
            const created = payment.createdAt ? payment.createdAt.toDate().toLocaleDateString('en-US') : '—';
            let userProfileHtml = '';
            try {
                const userDoc = await getDoc(doc(db, 'users', payment.userId));
                if (userDoc.exists()) {
                    const u = userDoc.data();
                    userProfileHtml = `
                        <div style="margin-top:1.5rem;border-top:1px solid #E2E8F0;padding-top:1rem;">
                            <h3>User Profile</h3>
                            <p><strong>Name:</strong> ${escapeHTML(u.name || '—')}</p>
                            <p><strong>Email:</strong> ${escapeHTML(u.email || '—')}</p>
                            <p><strong>Role:</strong> ${escapeHTML(u.role || '—')}</p>
                            <p><strong>UID:</strong> ${payment.userId}</p>
                            <button class="btn btn-sm btn-outline" onclick="window.open('user-profile.html?id=${payment.userId}')">Full Profile</button>
                        </div>`;
                } else {
                    userProfileHtml = `<p style="margin-top:1rem;">User profile not found in Firestore.</p>`;
                }
            } catch(e) { userProfileHtml = '<p>Error loading profile.</p>'; }

            document.getElementById('modal-body').innerHTML = `
                <div class="invoice-details" style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;">
                    <div><span style="color:#64748B;font-size:0.75rem;">Invoice #</span><br><strong>#${payment.id.substring(0,8).toUpperCase()}</strong></div>
                    <div><span style="color:#64748B;font-size:0.75rem;">Date</span><br>${created}</div>
                    <div><span style="color:#64748B;font-size:0.75rem;">Customer</span><br>${escapeHTML(cust.name)}</div>
                    <div><span style="color:#64748B;font-size:0.75rem;">Company</span><br>${escapeHTML(cust.company || '—')}</div>
                    <div><span style="color:#64748B;font-size:0.75rem;">Email</span><br>${escapeHTML(cust.email)}</div>
                    <div><span style="color:#64748B;font-size:0.75rem;">Phone</span><br>${escapeHTML(cust.phone)}</div>
                    <div style="grid-column:1/-1;"><span style="color:#64748B;font-size:0.75rem;">Address</span><br>${escapeHTML(cust.street)}, ${escapeHTML(cust.city)}, ${escapeHTML(cust.province)}, ${escapeHTML(cust.country)}</div>
                </div>
                <div style="margin-top:1rem;background:#F8FAFC;padding:1rem;border-radius:8px;">
                    <strong>Plan:</strong> ${periodMap[payment.billingPeriod] || payment.billingPeriod}<br>
                    <strong>Amount:</strong> $${payment.amount} USD<br>
                    <strong>Status:</strong> <span class="status-badge status-${payment.status}">${payment.status}</span>
                </div>
                ${userProfileHtml}
            `;
            document.getElementById('detail-modal').classList.add('active');
        };

        window.closeModal = () => document.getElementById('detail-modal').classList.remove('active');

        window.approvePayment = async (paymentId) => {
            if (!confirm('Approve this payment and activate subscription?')) return;
            try {
                const payment = allPayments.find(p => p.id === paymentId);
                if (!payment) throw new Error('Payment not found');
                const now = new Date();
                const period = payment.billingPeriod || 'monthly';
                let months = 1;
                if (period === 'quarterly') months = 3;
                else if (period === 'biannually') months = 6;
                else if (period === 'annually') months = 12;
                const expiry = new Date(now);
                expiry.setMonth(expiry.getMonth() + months);

                // Update payment doc
                await updateDoc(doc(db, 'payments', paymentId), {
                    status: 'approved',
                    approvedBy: currentAdmin.uid,
                    approvedAt: serverTimestamp()
                });

                // Create/update subscription doc
                await setDoc(doc(db, 'subscriptions', payment.userId), {
                    userId: payment.userId,
                    plan: period,
                    billingPeriod: period,
                    amount: payment.amount,
                    status: 'active',
                    startDate: Timestamp.fromDate(now),
                    expiryDate: Timestamp.fromDate(expiry),
                    approvedBy: currentAdmin.uid,
                    approvedAt: serverTimestamp(),
                    paymentId: paymentId,
                    customer: payment.customer
                }, { merge: true });

                showToast('✅ Payment approved! Subscription activated.', 'success');
                loadPayments();
            } catch(e) {
                console.error(e);
                showToast('Error approving payment.', 'error');
            }
        };

        window.rejectPayment = async (paymentId) => {
            if (!confirm('Reject this invoice? The recruiter will need to resubmit.')) return;
            try {
                await updateDoc(doc(db, 'payments', paymentId), {
                    status: 'rejected',
                    rejectedBy: currentAdmin.uid,
                    rejectedAt: serverTimestamp()
                });
                // Also mark subscription as cancelled if exists
                const payment = allPayments.find(p => p.id === paymentId);
                if (payment) {
                    await setDoc(doc(db, 'subscriptions', payment.userId), {
                        status: 'cancelled',
                        cancelledAt: serverTimestamp()
                    }, { merge: true });
                }
                showToast('Invoice rejected.', 'info');
                loadPayments();
            } catch(e) {
                showToast('Error rejecting.', 'error');
            }
        };

        window.deletePayment = async (paymentId) => {
            if (!confirm('Permanently delete this invoice? This cannot be undone.')) return;
            try {
                await deleteDoc(doc(db, 'payments', paymentId));
                showToast('Invoice deleted.', 'success');
                loadPayments();
            } catch(e) {
                showToast('Error deleting.', 'error');
            }
        };

        window.signOut = () => signOut(auth).then(() => window.location.href = 'login.html');

        function showToast(msg, type='info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.style.background = type === 'error' ? '#DC2626' : type === 'success' ? '#10B981' : '#1E293B';
            toast.textContent = msg;
            container.appendChild(toast);
            setTimeout(() => { toast.style.opacity='0'; toast.style.transition='0.3s'; setTimeout(()=>toast.remove(),300); }, 4000);
        }

        function escapeHTML(str) { const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }

        window.showToast = showToast;
        window.escapeHTML = escapeHTML;
    </script>
</body>
</html>
